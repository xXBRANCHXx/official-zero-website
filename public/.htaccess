RewriteEngine On

# Render published content and metadata before crawlers run JavaScript.
# These rules also cover the existing articles directory and its HTML alias.
RewriteRule ^articles(?:/.*)?$ /articles.php [END]
RewriteRule ^articles\.html$ /articles.php [END]
RewriteRule ^sitemap-articles\.xml$ /sitemap-articles.php [END]

<Files "article-delivery.php">
    Require all denied
</Files>
